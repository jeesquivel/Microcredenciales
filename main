<script>
(function(){'use strict';
  
  let textSize=0;
  document.getElementById('sizeButton').addEventListener('click',function(){
    textSize=(textSize+1)%3;
    document.documentElement.style.setProperty('--reading-scale',[1,1.13,1.26][textSize]);
    this.textContent=['A+ Texto','A++ Texto','A Texto normal'][textSize];
  });
  document.getElementById('contrastButton').addEventListener('click',function(){
    const active=document.body.classList.toggle('high-contrast');
    this.setAttribute('aria-pressed',String(active));
  });
  const speakSupported=('speechSynthesis' in window && 'SpeechSynthesisUtterance' in window);
  const audioButtons=document.querySelectorAll('[data-audio]');
  if(!speakSupported){audioButtons.forEach(btn=>{btn.disabled=true;btn.title='Lectura de voz no disponible en este navegador';});}
  else{
    let current=null;
    audioButtons.forEach(button=>button.addEventListener('click',function(){
      const num=this.getAttribute('data-audio');
      const previous=current;
      window.speechSynthesis.cancel();
      audioButtons.forEach(b=>{b.textContent='◖)) Escuchar respuesta';b.setAttribute('aria-pressed','false')});
      if(previous===num){current=null;return;}
      const paragraph=document.getElementById('respuesta-'+num);
      const question=document.querySelector('#pregunta-'+num+' h3');
      const speech=new SpeechSynthesisUtterance(question.textContent+'. '+paragraph.textContent);
      speech.lang='es-CR';speech.rate=.93;
      current=num;
      this.textContent='■ Detener lectura';this.setAttribute('aria-pressed','true');
      const reset=()=>{if(current===num){current=null;this.textContent='◖)) Escuchar respuesta';this.setAttribute('aria-pressed','false')}};
      speech.onend=reset;speech.onerror=reset;
      window.speechSynthesis.speak(speech);
    }));
    window.addEventListener('pagehide',()=>window.speechSynthesis.cancel());
  }
})();
</script>
